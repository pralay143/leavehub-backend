DJANGO_SECRET_KEY=replace-with-a-local-only-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://leavehub_user:replace-me@localhost:5432/leavehub_db
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Access token lifetime in minutes (default 15; 1-1440). Raise it locally for manual API testing.
JWT_ACCESS_MINUTES=15
# Email notifications. "console" prints emails in the runserver terminal; "smtp" sends them.
EMAIL_MODE=console
# Only used when EMAIL_MODE=smtp (for Gmail, use an app password, never your normal password):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="LeaveHub <noreply@localhost>"
# Base URL of the web app, used for links in emails.
FRONTEND_URL=http://localhost:5173
